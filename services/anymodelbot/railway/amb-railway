#!/bin/sh
# AnyModelBot on Railway: start wrapper. Runs as root (Railway's podman-init is PID 1), prepares the volume and
# the environment, then exec's AnyModelBot unchanged as the image's `node` user. Values typed into the deploy form
# never stop the start: anything invalid falls back to a safe default with a log line.
set -eu

APP_DIR=/app
DATA_DIR=/data
APP_USER=node
APP_HOME=/home/node
HELPER=/opt/amb-railway/amb-railway.mjs
DEFAULT_PORT=3600
TOKEN_MIN=24
MEM_WARN_BYTES=1073741824
IS_ROOT=0
if [ "$(id -u)" = 0 ]; then IS_ROOT=1; fi

log() { printf 'amb-railway: %s\n' "$*"; }

pick_port() {
  p="${PORT:-}"
  case "$p" in
    '' ) p=$DEFAULT_PORT ;;
    *[!0-9]* ) log "PORT='$p' is not a number; using $DEFAULT_PORT"; p=$DEFAULT_PORT ;;
  esac
  if [ "${#p}" -gt 5 ]; then log "PORT=$p is out of range; using $DEFAULT_PORT"; p=$DEFAULT_PORT; fi
  if [ "$p" -lt 1 ] || [ "$p" -gt 65535 ]; then
    log "PORT=$p is out of range; using $DEFAULT_PORT"
    p=$DEFAULT_PORT
  fi
  PORT=$p
  AMB_UI_PORT=$p
  export PORT AMB_UI_PORT
}

pick_host() {
  # Dual stack for Railway's edge and private network; IPv4 only if the kernel has no IPv6.
  if [ -e /proc/net/if_inet6 ]; then AMB_UI_HOST='::'; else AMB_UI_HOST='0.0.0.0'; fi
  export AMB_UI_HOST
}

prepare_volume() {
  AMB_DATA_DIR=$DATA_DIR
  export AMB_DATA_DIR
  mkdir -p "$DATA_DIR" || log "cannot create $DATA_DIR"
  if [ "$IS_ROOT" = 1 ]; then
    # A new Railway volume is owned by root; the app runs as `node`. Only files with another owner are touched.
    find "$DATA_DIR" -xdev \( ! -user "$APP_USER" -o ! -group "$APP_USER" \) -exec chown -h "$APP_USER:$APP_USER" {} + 2>/dev/null \
      || log "could not hand every file on $DATA_DIR to $APP_USER; the app may report permission errors"
  fi
  node "$HELPER" lock "$DATA_DIR/anymodel.lock" || log "lock check failed; AnyModelBot decides on its own"
}

check_token() {
  t="${AMB_UI_TOKEN:-}"
  if [ -z "$t" ]; then
    unset AMB_UI_TOKEN
    log "console token: AMB_UI_TOKEN is empty, so AnyModelBot uses the token in $DATA_DIR/ui-token (railway ssh, then: cat $DATA_DIR/ui-token)"
    return 0
  fi
  ok=1
  case "$t" in *[!A-Za-z0-9._~-]*) ok=0 ;; esac
  if [ "${#t}" -lt "$TOKEN_MIN" ] || [ "${#t}" -gt 512 ]; then ok=0; fi
  t=""
  if [ "$ok" = 1 ]; then
    log "console token: from AMB_UI_TOKEN (open AMB_LOGIN_URL from the Variables tab once per browser)"
    return 0
  fi
  unset AMB_UI_TOKEN
  log "console token: AMB_UI_TOKEN must be $TOKEN_MIN-512 letters, digits or . _ ~ - and was ignored for safety"
  log "console token: AnyModelBot now uses the token in $DATA_DIR/ui-token (railway ssh, then: cat $DATA_DIR/ui-token); AMB_LOGIN_URL works again once AMB_UI_TOKEN is fixed"
}

check_tz() {
  z="${TZ:-}"
  if [ -n "$z" ] && ! node "$HELPER" tz "$z"; then
    log "TZ='$z' is not a known time zone; using UTC (rules and quiet hours follow TZ)"
    z=""
  fi
  TZ="${z:-UTC}"
  export TZ
}

check_memory() {
  limit=""
  for f in /sys/fs/cgroup/memory.max /sys/fs/cgroup/memory/memory.limit_in_bytes; do
    if [ -r "$f" ]; then limit=$(cat "$f" 2>/dev/null || true); break; fi
  done
  case "$limit" in
    '' | max | *[!0-9]* ) log "memory limit: none reported"; return 0 ;;
  esac
  log "memory limit: $((limit / 1048576)) MiB"
  if [ "$limit" -lt "$MEM_WARN_BYTES" ]; then
    log "memory: under 1 GiB. AnyModelBot boots, but several bots or Python/FFmpeg work can exceed it; Hobby or above is recommended"
    if [ -z "${AMB_AGENT_PREWARM:-}" ]; then
      AMB_AGENT_PREWARM=0
      export AMB_AGENT_PREWARM
      log "memory: agent prewarm off, the agent process starts with the first message instead"
    fi
  fi
}

check_sandbox() {
  [ "$IS_ROOT" = 1 ] || return 0
  if timeout 10 setpriv --reuid="$APP_USER" --regid="$APP_USER" --init-groups bwrap --ro-bind / / /bin/true >/dev/null 2>&1; then
    log "agent sandbox: bubblewrap works"
  else
    log "agent sandbox: bubblewrap cannot run in this container; the agent falls back to Landlock where the kernel allows it"
    log "agent sandbox: if bot commands fail with a sandbox error, switch that bot to Full access (the container is then the boundary)"
  fi
}

start_key_seeder() {
  vars=$(node "$HELPER" key-vars) || { log "model keys: helper failed, keys from variables are not connected"; return 0; }
  found=""
  set -- PATH="$PATH" HOME=/root AMB_SEED_PORT="$PORT" AMB_SEED_TOKEN_FILE="$DATA_DIR/ui-token"
  if [ -n "${AMB_UI_TOKEN:-}" ]; then set -- "$@" AMB_SEED_TOKEN="$AMB_UI_TOKEN"; fi
  for v in $vars; do
    eval "val=\${$v:-}"
    if [ -n "$val" ]; then
      set -- "$@" "$v=$val"
      found="$found $v"
    fi
    unset "$v"
  done
  val=""
  if [ -z "$found" ]; then
    log "model keys: none set; sign in to Modelflare or add your own API key in the console"
    return 0
  fi
  # Detached (PID 1 reaps it) and, as root, out of reach of the bots' shell user: the keys stay out of the app's
  # environment and go to AnyModelBot only through its own API.
  ( env -i "$@" node "$HELPER" seed </dev/null & )
  log "model keys:$found will be connected in the background"
}

run_app() {
  cd "$APP_DIR"
  if [ "$IS_ROOT" = 1 ]; then
    exec setpriv --reuid="$APP_USER" --regid="$APP_USER" --init-groups --no-new-privs \
      env HOME="$APP_HOME" USER="$APP_USER" LOGNAME="$APP_USER" node dist/src/main.js
  fi
  log "not started as root; running AnyModelBot as $(id -un) without volume preparation"
  exec node dist/src/main.js
}

main() {
  pick_port
  pick_host
  prepare_volume
  check_token
  check_tz
  check_memory
  check_sandbox
  start_key_seeder
  unset AMB_LOGIN_URL 2>/dev/null || true
  log "starting AnyModelBot on [$AMB_UI_HOST]:$PORT, data $DATA_DIR, TZ $TZ, language ${AMB_LANG:-system}"
  run_app
}

main
